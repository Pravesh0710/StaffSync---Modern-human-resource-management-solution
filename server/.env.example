# Server Configuration
PORT=5000
NODE_ENV=development

# Database Configuration
# For local MongoDB: mongodb://127.0.0.1:27017/staffsync
# For MongoDB Atlas: mongodb+srv://<username>:<password>@cluster.mongodb.net/staffsync?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/staffsync

# Test Database (used by Jest — separate DB so dev data is never wiped)
MONGO_URI_TEST=mongodb://127.0.0.1:27017/staffsync_test

# JWT Configuration
JWT_SECRET=replace_with_a_secure_random_secret_minimum_32_characters
JWT_EXPIRES_IN=7d

# CORS Configuration
CLIENT_URL=http://localhost:5173
